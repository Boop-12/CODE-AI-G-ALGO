ENVIRONMENT=production
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
SECRET_KEY=REPLACE_WITH_AT_LEAST_40_RANDOM_CHARACTERS
COOKIE_SECURE=true
SESSION_MINUTES=60
ALLOWED_ORIGINS=https://gnkalgo.com,https://www.gnkalgo.com
APP_BASE_URL=https://gnkalgo.com
# Configure a real SMTP provider before enabling production account emails.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=noreply@gnkalgo.com
TLS_DIR=/opt/gnkalgo/tls

# Existing Certbot HTTP-01 webroot on this host.
ACME_WEBROOT=/opt/gnkalgo_AI/certbot/www
# Optional CA override, e.g. Cloudflare Origin CA root bundle.
# TLS_CA_FILE=/opt/gnkalgo/tls/cloudflare-origin-ca.pem
