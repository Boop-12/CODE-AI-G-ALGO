# Copy to .env. Use URL-safe (hex) secrets; never commit .env.
ENVIRONMENT=development
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=replace_with_64_random_hex_characters
SECRET_KEY=development-only-change-before-deployment
COOKIE_SECURE=false
SESSION_MINUTES=60
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000
# For native local backend development only; Docker supplies DATABASE_URL.
# DATABASE_URL=sqlite+aiosqlite:///./local.db
